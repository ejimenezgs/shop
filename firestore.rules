rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        "hello@oaxsun.tech",
        "e.jimenez@gruposegel.com",
        "contacto@gruposegel.com"
      ];
    }

    function isStripeBackend() {
      return isSignedIn()
        && request.auth.token.email == "stripe-backend@casaglick.com"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasOnly([
          "folio", "status", "customer", "items", "subtotal", "total",
          "createdAt", "createdAtClient", "source", "paymentMethod",
          "paymentStatus", "stripeSessionId", "checkoutAttempt"
        ])
        && request.resource.data.keys().hasAll([
          "folio", "status", "customer", "items", "subtotal", "total",
          "createdAt", "createdAtClient", "source"
        ])
        && request.resource.data.folio is string
        && request.resource.data.folio.size() >= 8
        && request.resource.data.folio.size() <= 40
        && request.resource.data.customer is map
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.total >= 0
        && request.resource.data.source == "web"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtClient is string
        && (
          request.resource.data.status == "Nueva"
          || (
            request.resource.data.status == "Pendiente de pago"
            && request.resource.data.paymentMethod == "stripe"
            && request.resource.data.paymentStatus == "pending"
            && request.resource.data.checkoutAttempt == 0
          )
        );
    }

    match /catalogProductOverrides/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /catalogSettings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shopContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name", "email", "phone", "message", "source", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 3000
        && request.resource.data.source in ["casaglick.com", "shop.casaglick.com"]
        && request.resource.data.status == "unread"
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status"])
        && request.resource.data.status in ["unread", "read", "archived"];
    }

    match /orders/{orderId} {
      allow create: if validOrderCreate();
      allow read, update: if isAdmin() || isStripeBackend();
      allow delete: if isAdmin();
    }

    match /inventoryStockReservations/{skuId} {
      allow read: if true;
      allow write: if isStripeBackend();
    }

    match /inventoryReservationOrders/{orderId} {
      allow read, write: if isStripeBackend();
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if isStripeBackend();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
